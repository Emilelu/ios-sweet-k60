 /* Copy each enabled layer's surface into the panel memory (no scaling). */
@@ -495,8 +496,57 @@
 				    (size_t)w * 4);
 			}
 		}
+		/*
+		 * SWEET: say what the composited layer actually contains. A surface of
+		 * zeros means the producer is not drawing (no GPU); a surface with
+		 * pixels that still ends up invisible on the panel means the copy or the
+		 * scanout is wrong, and those are very different problems.
+		 */
+		if (layer == 0 && sweet_fb_samples_logged < 8) {
+			sweet_fb_samples_logged++;
+			uint32_t nonzero = 0, first = 0, sampled = 0;
+			uintptr_t cp = s->kernelAddress();
+
+			if (cp != 0) {
+				for (uint32_t i = 0; i < 4096; i++) {
+					uint32_t v;
+
+					memcpy(&v, (const void *)(cp + (uintptr_t)i * 4096),
+					    sizeof(v));
+					if (i == 0) {
+						first = v;
+					}
+					nonzero += (v != 0);
+					sampled++;
+				}
+			}
+			IOLog("SWEET FB: layer %u surface %u first 0x%08x nonempty %u/%u\n",
+			    layer, s->id, first, nonzero, sampled);
+		}
+
 		s->release();
 	}
+
+	/*
+	 * SWEET: paint a test pattern over the top-left corner. If it shows up, the
+	 * copy into panel memory and the scanout both work and a black screen means
+	 * the producers are sending black frames, not that the plumbing is broken.
+	 */
+	static int test = -1;
+
+	if (test < 0) {
+		test = 0;
+		(void)PE_parse_boot_argn("sweetfb_test", &test, sizeof(test));
+	}
+	if (test != 0 && fPixels != 0) {
+		uint32_t *row = (uint32_t *)(fPixels + (uint64_t)8 * fRowBytes);
+
+		for (int32_t x = 0; x < 480; x++) {
+			row[x] = 0xFFFF0000u;               /* red */
+			row[x + 480] = 0xFF00FF00u;         /* green */
+			row[x + 960] = 0xFF0000FFu;         /* blue */
+		}
+	}
 }
 
