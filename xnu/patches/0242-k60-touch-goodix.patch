xnu: K60 触摸 0242：Goodix 协议（Berlin 与 GT9xx 两套 ABI）

0241 之后 SPI 能发了；这个补丁读芯片、解析触点，并交给仓库里已有的
SweetHIDTouch，不另造一套 IOHID 注入。

  bsd/dev/k60_touch_goodix.c   探针 + 两套 ABI 的读/写帧 + 报告解析 + 抬起

型号没有在硬件上确认过（DT 只有 xiaomi,m11a-spi / goodix_firmware_m11a），
所以两套都实现，用"谁回得出校验和正确的数据"来决定：

  Berlin（pong 用的那代，GT9916 一类）
    读 0xf1 + 4 字节地址 + 3 字节 0xff；写 0xf0 + 4 字节地址
    固件版本 0x10014（28 字节，末尾 16 位是和）；IC info 0x10070
    IC info 的 misc 段 +44 是触点报告地址、+48/+50 必须是 8、+52/+54 是坐标
    上限 —— 这一段是照抄 pong 的厂商扩展，通用 ABI 里没有
  老 GT9xx
    0x81 0x40 两字节命令后跟数据（有些固件前面还要一个 0x20，两种都试）
    产品 id 0x8140、状态 0x814E（bit7 有新报告、低四位点数）、触点 0x8150

两套的 0x8140 / 0x814E / 0x8150 与 0x10014 / 0x10070 都是 Goodix 的公开地址，
不是板级参数。坐标换算：IC 的 0.1 mm -> 面板像素，上限优先取 IC info 自报的
值，缺省用 DT 的 panel-max-x/y = 14400 / 32000（live FDT goodix,panel-max-x
= 0x3840、panel-max-y = 0x7d00），面板 1440x3200。

上报走 sweet_hid_touch(finger, down, x, y)（iokit/Kernel/arm/hid/SweetHID.cpp
里 SweetHIDTouch::touch 的 C 入口），坐标是面板像素；按下/移动/抬起都在这里
算，SweetHIDTouch 负责 IOHIDEvent 与逻辑坐标缩放。

上机判据：

  id: berlin fw chip "911" firmware "..." 1.00.00.00 sensor N   Berlin 有应答
  id: berlin touch report at 0x... , command at 0x... , axes 14400 x 32000
  id: gt9xx prefix 0 id 39 31 31 31 (text)   GT9xx 有应答
  id: gt9xx text 9111
  abi berlin selected, axes 14400 x 32000, panel 1440 x 3200   ← 成败行
  abi none: the chip answers neither framing                   两套都不通
  touch finger 0 at 7200, 16000 -> 720, 1600 px                头四个触点
  bad report header / bad report (N touches)                   校验和不过的原始字节

坐标镜像用 k60touchflip（1 = 左右、2 = 上下），默认不翻。
diff --git a/bsd/dev/k60_touch_goodix.c b/bsd/dev/k60_touch_goodix.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/k60_touch_goodix.c
@@ -0,0 +1,547 @@
+/*
+ * K60（mondrian，SM8475）触摸：Goodix 协议。
+ *
+ * 芯片型号没有在硬件上确认过，所以这里同时实现两套 ABI，探针用"谁回得出
+ * 校验和正确的数据"来决定用哪一套，并把两边的原始字节都打进日志：
+ *
+ *   Berlin（GT9916 一代，pong 用的那套）
+ *     读：0xf1 + 4 字节地址 + 3 字节 0xff，然后读数据
+ *     写：0xf0 + 4 字节地址 + 数据
+ *     产品信息在 0x10014（28 字节，末尾 16 位是和）与 0x10070（IC info）
+ *   GT9xx（老的 0x8140 产品 id）
+ *     读：0x81 0x40 两字节命令后跟数据（有些固件前面还要一个 0x20）
+ *     状态在 0x814E（bit7 = 有新报告，低四位 = 触点数），触点在 0x8150
+ *
+ * 坐标换算：IC 报的是 0.1 mm，上限由 IC info 或 DT 的 panel-max-x/y 给出
+ * （14400 / 32000），按比例换成面板像素（1440 x 3200），再交给仓库里已有的
+ * SweetHIDTouch（sweet_hid_touch()，iOS 16.7 的 HID 注入，不另造一套）。
+ *
+ * 判据行：
+ *   "K60 TOUCH: id: berlin fw ..."           Berlin 的固件版本解码
+ *   "K60 TOUCH: id: berlin touch report at ..."  Berlin 找到了报告地址
+ *   "K60 TOUCH: id: gt9xx prefix %u ..."     GT9xx 两种框法的四字节
+ *   "K60 TOUCH: abi %s selected ..."         最终选中的 ABI（这是成败行）
+ *   "K60 TOUCH: touch finger %u ..."         头四个触点（原始 + 像素）
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/k60_touch.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+#define K60_ABI_NONE		0
+#define K60_ABI_BERLIN		1
+#define K60_ABI_GT9XX		2
+
+#define K60_GOODIX_MAX_READ	1024
+#define K60_GOODIX_MAX_TOUCHES	K60_TOUCH_REPORT_MAX
+
+/* Berlin 的地址表。 */
+#define K60_BERLIN_FW_VERSION	0x10014u
+#define K60_BERLIN_IC_INFO	0x10070u
+#define K60_BERLIN_STATUS_TOUCH	0x80u
+#define K60_BERLIN_STATUS_REQUEST 0x40u
+#define K60_BERLIN_REQUEST_RESET 3u
+
+/* GT9xx 的地址表。 */
+#define K60_GT9XX_PRODUCT_ID	0x8140u
+#define K60_GT9XX_STATUS	0x814eu
+#define K60_GT9XX_POINTS	0x8150u
+
+static int k60_abi;
+static uint32_t k60_berlin_touch, k60_berlin_cmd;
+static uint32_t k60_abs_x = K60_TOUCH_ABS_MAX_X;
+static uint32_t k60_abs_y = K60_TOUCH_ABS_MAX_Y;
+static int k60_gt9xx_prefix;
+static int k60_flip;
+static unsigned k60_shown;
+
+static uint8_t k60_tx[8 + K60_GOODIX_MAX_READ];
+static uint8_t k60_rx[8 + K60_GOODIX_MAX_READ];
+
+/* 上一次报告里每根手指的状态（下压/坐标），抬起时才需要旧坐标。 */
+struct k60_contact {
+	int down, seen, x, y;
+};
+static struct k60_contact k60_contacts[K60_GOODIX_MAX_TOUCHES];
+
+static uint16_t
+k60_le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static uint32_t
+k60_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 |
+	    (uint32_t)p[3] << 24;
+}
+
+/* 块的和：末尾 16 位小端。全 0 或全 ff 是"没有应答"，不算有效。 */
+static int
+k60_checksum_ok(const uint8_t *data, uint32_t length)
+{
+	uint32_t sum = 0;
+	int blank = 1;
+	uint32_t i;
+
+	if (length < 2) {
+		return 0;
+	}
+	for (i = 0; i < length - 2; i++) {
+		sum += data[i];
+		if (data[i] != 0 && data[i] != 0xff) {
+			blank = 0;
+		}
+	}
+	return !blank && (uint16_t)sum ==
+	    (uint16_t)(data[length - 2] | data[length - 1] << 8);
+}
+
+static int
+k60_printable(const uint8_t *p, uint32_t n)
+{
+	uint32_t i;
+
+	for (i = 0; i < n; i++) {
+		if (p[i] < 0x20 || p[i] >= 0x7f) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* ---- Berlin 的帧 ---------------------------------------------------------- */
+
+static int
+k60_berlin_read(uint32_t address, uint8_t *data, uint32_t length)
+{
+	if (length > K60_GOODIX_MAX_READ) {
+		return -1;
+	}
+	k60_tx[0] = 0xf1;
+	k60_tx[1] = (uint8_t)(address >> 24);
+	k60_tx[2] = (uint8_t)(address >> 16);
+	k60_tx[3] = (uint8_t)(address >> 8);
+	k60_tx[4] = (uint8_t)address;
+	k60_tx[5] = k60_tx[6] = k60_tx[7] = 0xff;
+	memset(k60_tx + 8, 0, length);
+	if (k60_touch_geni_xfer(k60_tx, k60_rx, 8 + length) != 0) {
+		return -1;
+	}
+	memcpy(data, k60_rx + 8, length);
+	return 0;
+}
+
+static int
+k60_berlin_write(uint32_t address, const uint8_t *data, uint32_t length)
+{
+	if (length > K60_GOODIX_MAX_READ) {
+		return -1;
+	}
+	k60_tx[0] = 0xf0;
+	k60_tx[1] = (uint8_t)(address >> 24);
+	k60_tx[2] = (uint8_t)(address >> 16);
+	k60_tx[3] = (uint8_t)(address >> 8);
+	k60_tx[4] = (uint8_t)address;
+	memcpy(k60_tx + 5, data, length);
+	return k60_touch_geni_xfer(k60_tx, NULL, 5 + length);
+}
+
+/* ---- GT9xx 的帧 ----------------------------------------------------------- */
+
+/*
+ * 老 ABI 在 SPI 上把 16 位地址拆成两字节，读的时候第一字节的 bit7 置一。
+ * 有些固件的读命令前面还要一个 0x20（I2C 那边"写标志"的残留），两种都试。
+ */
+static int
+k60_gt9xx_read(uint32_t address, uint8_t *data, uint32_t length)
+{
+	uint32_t off = k60_gt9xx_prefix ? 1 : 0;
+
+	if (length + 2 + off > K60_GOODIX_MAX_READ) {
+		return -1;
+	}
+	if (off) {
+		k60_tx[0] = 0x20;
+	}
+	k60_tx[off + 0] = (uint8_t)(0x80u | ((address >> 8) & 0x7fu));
+	k60_tx[off + 1] = (uint8_t)address;
+	memset(k60_tx + off + 2, 0, length);
+	if (k60_touch_geni_xfer(k60_tx, k60_rx, off + 2 + length) != 0) {
+		return -1;
+	}
+	memcpy(data, k60_rx + off + 2, length);
+	return 0;
+}
+
+static int
+k60_gt9xx_write(uint32_t address, const uint8_t *data, uint32_t length)
+{
+	uint32_t off = k60_gt9xx_prefix ? 1 : 0;
+
+	if (length + 2 + off > K60_GOODIX_MAX_READ) {
+		return -1;
+	}
+	if (off) {
+		k60_tx[0] = 0x20;
+	}
+	k60_tx[off + 0] = (uint8_t)((address >> 8) & 0x7fu);
+	k60_tx[off + 1] = (uint8_t)address;
+	memcpy(k60_tx + off + 2, data, length);
+	return k60_touch_geni_xfer(k60_tx, NULL, off + 2 + length);
+}
+
+/* ---- 这两套 ABI 的复位 ---------------------------------------------------- */
+
+static void
+k60_touch_reset(void)
+{
+	(void)k60_touch_pin_output(K60_TOUCH_GPIO_RESET, 0,
+	    K60_TOUCH_PIN_PULL_NONE, K60_TOUCH_PIN_DRIVE_8MA);
+	delay(2 * 1000);
+	(void)k60_touch_pin_output(K60_TOUCH_GPIO_RESET, 1,
+	    K60_TOUCH_PIN_PULL_NONE, K60_TOUCH_PIN_DRIVE_8MA);
+	delay(100 * 1000);
+}
+
+/* ---- 探针：Berlin --------------------------------------------------------- */
+
+static int
+k60_berlin_probe(int verbose)
+{
+	static uint8_t info[K60_GOODIX_MAX_READ];
+	uint8_t version[28];
+	uint32_t length, offset;
+	int i;
+
+	if (k60_berlin_read(K60_BERLIN_FW_VERSION, version,
+	    sizeof(version)) != 0) {
+		return -1;
+	}
+	if (!k60_checksum_ok(version, sizeof(version))) {
+		if (verbose) {
+			printf("K60 TOUCH: id: berlin fw has no checksum: "
+			    "%02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    version[0], version[1], version[2], version[3],
+			    version[4], version[5], version[6], version[7]);
+		}
+		return -1;
+	}
+	printf("K60 TOUCH: id: berlin fw chip \"%.6s\" firmware \"%.8s\" "
+	    "%02x.%02x.%02x.%02x sensor %u\n", (const char *)version,
+	    (const char *)version + 10, version[18], version[19], version[20],
+	    version[21], version[23]);
+
+	if (k60_berlin_read(K60_BERLIN_IC_INFO, info, 2) != 0) {
+		return -1;
+	}
+	length = k60_le16(info);
+	if (length < 40 || length >= K60_GOODIX_MAX_READ ||
+	    k60_berlin_read(K60_BERLIN_IC_INFO, info, length) != 0 ||
+	    !k60_checksum_ok(info, length)) {
+		printf("K60 TOUCH: id: berlin IC info bad (length %u)\n", length);
+		return -1;
+	}
+	/* 长度(2) + 版本(16) + 特性(10) + 四个计数(4)，后面是五张 16 位的表。 */
+	offset = 2 + 16 + 10 + 4;
+	for (i = 0; i < 5; i++) {
+		if (offset >= length) {
+			printf("K60 TOUCH: id: berlin IC info truncated at list %d\n",
+			    i);
+			return -1;
+		}
+		offset += 1 + 2u * info[offset];
+	}
+	if (offset + 48 + 2 > length) {
+		printf("K60 TOUCH: id: berlin IC info too short (%u, lists end "
+		    "at %u)\n", length, offset);
+		return -1;
+	}
+	k60_berlin_touch = k60_le32(info + offset + 44);
+	k60_berlin_cmd = k60_le32(info + offset + 0);
+	/*
+	 * pong 的厂商扩展：misc 段 +48 是头长度、+50 是点大小，都必须等于 8，
+	 * +52/+54 是真实的坐标上限。这一段是"照抄 pong"，不是通用 ABI。
+	 */
+	if (offset + 56 + 2 > length || k60_le16(info + offset + 48) != 8 ||
+	    k60_le16(info + offset + 50) != 8) {
+		printf("K60 TOUCH: id: berlin vendor misc block absent, keeping "
+		    "DT limits %u x %u\n", k60_abs_x, k60_abs_y);
+	} else {
+		uint16_t x = k60_le16(info + offset + 52);
+		uint16_t y = k60_le16(info + offset + 54);
+
+		if (x != 0 && y != 0) {
+			k60_abs_x = x;
+			k60_abs_y = y;
+		}
+	}
+	printf("K60 TOUCH: id: berlin touch report at %#x, command at %#x, "
+	    "axes %u x %u\n", k60_berlin_touch, k60_berlin_cmd, k60_abs_x,
+	    k60_abs_y);
+	return k60_berlin_touch != 0 ? 0 : -1;
+}
+
+/* ---- 探针：GT9xx ---------------------------------------------------------- */
+
+static int
+k60_gt9xx_probe(int verbose)
+{
+	uint8_t id[4] = { 0, 0, 0, 0 };
+	int prefix, ok = -1;
+
+	for (prefix = 0; prefix < 2; prefix++) {
+		k60_gt9xx_prefix = prefix;
+		memset(id, 0, sizeof(id));
+		if (k60_gt9xx_read(K60_GT9XX_PRODUCT_ID, id, sizeof(id)) != 0) {
+			printf("K60 TOUCH: id: gt9xx prefix %d transfer failed\n",
+			    prefix);
+			continue;
+		}
+		printf("K60 TOUCH: id: gt9xx prefix %d id %02x %02x %02x %02x%s\n",
+		    prefix, id[0], id[1], id[2], id[3],
+		    k60_printable(id, sizeof(id)) ? " (text)" : "");
+		if (k60_printable(id, sizeof(id))) {
+			printf("K60 TOUCH: id: gt9xx text %c%c%c%c\n", id[0],
+			    id[1], id[2], id[3]);
+			ok = 0;
+			break;
+		}
+	}
+	if (ok != 0) {
+		k60_gt9xx_prefix = 0;
+		if (verbose) {
+			printf("K60 TOUCH: id: gt9xx answered nothing "
+			    "(0x8140 not readable)\n");
+		}
+	}
+	return ok;
+}
+
+int
+k60_touch_goodix_probe(int verbose)
+{
+	(void)PE_parse_boot_argn("k60touchflip", &k60_flip, sizeof(k60_flip));
+
+	/* 先试 Berlin（pong 同一代的芯片），再试老的 GT9xx。 */
+	if (k60_berlin_probe(verbose) == 0) {
+		k60_abi = K60_ABI_BERLIN;
+	} else if (k60_gt9xx_probe(verbose) == 0) {
+		k60_abi = K60_ABI_GT9XX;
+	} else {
+		k60_abi = K60_ABI_NONE;
+		printf("K60 TOUCH: abi none: the chip answers neither framing\n");
+		k60_touch_flush();
+		return -1;
+	}
+	printf("K60 TOUCH: abi %s selected, axes %u x %u, panel %u x %u\n",
+	    k60_abi == K60_ABI_BERLIN ? "berlin" : "gt9xx", k60_abs_x,
+	    k60_abs_y, K60_TOUCH_PANEL_W, K60_TOUCH_PANEL_H);
+	k60_touch_flush();
+	return 0;
+}
+
+int
+k60_touch_goodix_abi(void)
+{
+	return k60_abi;
+}
+
+/* ---- 触点 -> SweetHIDTouch ------------------------------------------------ */
+
+static int
+k60_to_pixel(uint32_t value, uint32_t maximum, uint32_t panel)
+{
+	uint32_t scaled;
+
+	if (maximum == 0) {
+		return 0;
+	}
+	scaled = (uint32_t)(((uint64_t)value * panel) / maximum);
+	if (scaled >= panel) {
+		scaled = panel - 1;
+	}
+	return (int)scaled;
+}
+
+static void
+k60_report(uint32_t finger, int down, uint32_t raw_x, uint32_t raw_y)
+{
+	int x = k60_to_pixel(raw_x, k60_abs_x, K60_TOUCH_PANEL_W);
+	int y = k60_to_pixel(raw_y, k60_abs_y, K60_TOUCH_PANEL_H);
+
+	if (k60_flip & 1) {
+		x = K60_TOUCH_PANEL_W - 1 - x;
+	}
+	if (k60_flip & 2) {
+		y = K60_TOUCH_PANEL_H - 1 - y;
+	}
+	k60_contacts[finger].x = x;
+	k60_contacts[finger].y = y;
+	k60_contacts[finger].down = down;
+	if (down && k60_shown < 4) {
+		k60_shown++;
+		printf("K60 TOUCH: touch finger %u at %u, %u -> %d, %d px\n",
+		    finger, raw_x, raw_y, x, y);
+		k60_touch_flush();
+	}
+	sweet_hid_touch((int)finger, down, x, y);
+}
+
+/*
+ * 一次报告里的触点集合：先把"seen"全部清掉，处理报上来的，最后把上一轮
+ * 还按着、这一轮不见了的当作抬起。
+ */
+static void
+k60_report_touches(const uint8_t *touches, uint32_t count, uint32_t stride,
+    int gt9xx)
+{
+	uint32_t i, id;
+
+	for (i = 0; i < K60_GOODIX_MAX_TOUCHES; i++) {
+		k60_contacts[i].seen = 0;
+	}
+	for (i = 0; i < count; i++) {
+		const uint8_t *t = touches + stride * i;
+		uint32_t raw_x, raw_y;
+
+		if (gt9xx) {
+			/* 8 字节：id、xL、xH、yL、yH、wL、wH、保留。 */
+			id = t[0];
+			raw_x = k60_le16(t + 1);
+			raw_y = k60_le16(t + 3);
+		} else {
+			/* Berlin：高四位是 id，低四位是类型（1、3 是笔）。 */
+			id = t[0] >> 4;
+			if ((t[0] & 0xfu) == 1 || (t[0] & 0xfu) == 3) {
+				continue;
+			}
+			raw_x = k60_le16(t + 2);
+			raw_y = k60_le16(t + 4);
+		}
+		if (id >= K60_GOODIX_MAX_TOUCHES) {
+			continue;
+		}
+		k60_contacts[id].seen = 1;
+		k60_report(id, 1, raw_x, raw_y);
+	}
+	for (id = 0; id < K60_GOODIX_MAX_TOUCHES; id++) {
+		if (k60_contacts[id].down && !k60_contacts[id].seen) {
+			k60_contacts[id].down = 0;
+			sweet_hid_touch((int)id, 0, k60_contacts[id].x,
+			    k60_contacts[id].y);
+		}
+	}
+}
+
+/* ---- 轮询 ---------------------------------------------------------------- */
+
+static int
+k60_berlin_poll(void)
+{
+	static uint8_t report[8 + 8 * K60_GOODIX_MAX_TOUCHES + 2];
+	static unsigned complaints;
+	const uint8_t zero = 0;
+	const uint32_t first = 8 + 8 * 2 + 2;	/* 头和两个触点，绝大多数时候够了 */
+	uint32_t count;
+
+	if (k60_berlin_read(k60_berlin_touch, report, first) != 0 ||
+	    report[0] == 0) {
+		return -1;
+	}
+	count = report[2] & 0xfu;
+	if ((report[0] & K60_BERLIN_STATUS_TOUCH) && count > 2 &&
+	    count <= K60_GOODIX_MAX_TOUCHES &&
+	    k60_berlin_read(k60_berlin_touch + 8, report + 8,
+	    8 * count + 2) != 0) {
+		return -1;
+	}
+	(void)k60_berlin_write(k60_berlin_touch, &zero, 1);
+	if (!k60_checksum_ok(report, 8)) {
+		if (complaints++ < 8) {
+			printf("K60 TOUCH: bad report header %02x %02x %02x %02x "
+			    "%02x %02x %02x %02x\n", report[0], report[1],
+			    report[2], report[3], report[4], report[5],
+			    report[6], report[7]);
+		}
+		return -1;
+	}
+	if (report[0] & K60_BERLIN_STATUS_REQUEST) {
+		printf("K60 TOUCH: the chip asks for command %u\n", report[2]);
+		if ((report[2] & 0xfu) == K60_BERLIN_REQUEST_RESET ||
+		    report[2] == K60_BERLIN_REQUEST_RESET) {
+			printf("K60 TOUCH: resetting the chip\n");
+			k60_touch_reset();
+		}
+		return 0;
+	}
+	if (!(report[0] & K60_BERLIN_STATUS_TOUCH)) {
+		/* 没有触点：把头里剩下的抬起处理掉。 */
+		k60_report_touches(report + 8, 0, 8, 0);
+		return 0;
+	}
+	if (count > K60_GOODIX_MAX_TOUCHES ||
+	    (count != 0 && !k60_checksum_ok(report + 8, count * 8 + 2))) {
+		if (complaints++ < 8) {
+			printf("K60 TOUCH: bad report (%u touches)\n", count);
+		}
+		return -1;
+	}
+	k60_report_touches(report + 8, count, 8, 0);
+	return 0;
+}
+
+static int
+k60_gt9xx_poll(void)
+{
+	static uint8_t points[8 * K60_GOODIX_MAX_TOUCHES];
+	static unsigned complaints;
+	uint8_t status = 0;
+	const uint8_t zero = 0;
+	uint32_t count;
+
+	if (k60_gt9xx_read(K60_GT9XX_STATUS, &status, 1) != 0) {
+		return -1;
+	}
+	if (!(status & 0x80u)) {
+		return -1;
+	}
+	count = status & 0x0fu;
+	if (count > K60_GOODIX_MAX_TOUCHES) {
+		count = 0;
+	}
+	if (count != 0 &&
+	    k60_gt9xx_read(K60_GT9XX_POINTS, points, 8 * count) != 0) {
+		return -1;
+	}
+	/* 状态位写 0 才清得掉；不清的话下一轮还是同一份报告。 */
+	if (k60_gt9xx_write(K60_GT9XX_STATUS, &zero, 1) != 0 &&
+	    complaints++ < 8) {
+		printf("K60 TOUCH: gt9xx status clear failed\n");
+	}
+	k60_report_touches(points, count, 8, 1);
+	return 0;
+}
+
+int
+k60_touch_goodix_poll(void)
+{
+	switch (k60_abi) {
+	case K60_ABI_BERLIN:
+		return k60_berlin_poll();
+	case K60_ABI_GT9XX:
+		return k60_gt9xx_poll();
+	default:
+		return -1;
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
