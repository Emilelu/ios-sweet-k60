--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -727,9 +727,22 @@
 static void
 fbcon_clear_row(uint32_t row)
 {
+	/* Four pixels per store: the framebuffer is write-combining memory, so
+	 * wide aligned stores keep the write-combine buffers full instead of
+	 * issuing one transaction per pixel. Text scrolling clears two rows per
+	 * newline, which made this the hottest loop in the console. */
+	typedef uint32_t vec4 __attribute__((vector_size(16)));
+
+	vec4 bg = { FBCON_BG, FBCON_BG, FBCON_BG, FBCON_BG };
+
 	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE; y++) {
 		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
-		for (uint32_t x = 0; x < fbcon_width; x++) {
+		uint32_t x = 0;
+
+		for (; x + 4 <= fbcon_width; x += 4) {
+			*(volatile vec4 *)(line + x) = bg;
+		}
+		for (; x < fbcon_width; x++) {
 			line[x] = FBCON_BG;
 		}
 	}
@@ -741,7 +754,6 @@
 	fbcon_col = 0;
 	fbcon_row = (fbcon_row + 1) % fbcon_rows;
 	fbcon_clear_row(fbcon_row);
-	fbcon_clear_row((fbcon_row + 1) % fbcon_rows);
 }
 
