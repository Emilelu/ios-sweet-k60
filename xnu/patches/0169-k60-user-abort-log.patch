 /*
+ * SWEET: a user-mode abort that vm_fault() could not satisfy kills the process.
+ * Print enough to tell "bad pointer" from "bad mapping": the ESR (fault class
+ * and translation level), FAR, the faulting instruction, the vm_fault result
+ * and the vm_map entry that covers FAR. The ring is flushed right away because
+ * launchd's exit path panics and the periodic flusher may never run again.
+ */
+void
+sweet_user_abort_log(uint32_t esr, uint64_t far, uint64_t elr, uint32_t fault_code,
+    int fault_type, int kr)
+{
+	proc_t p = current_proc();
+	vm_map_t map = current_map();
+	vm_map_entry_t entry = VM_MAP_ENTRY_NULL;
+	uint64_t vstart = 0, vend = 0;
+	int prot = -1;
+
+	vm_map_lock_read(map);
+	if (vm_map_lookup_entry(map, (vm_map_offset_t)far, &entry) &&
+	    entry != vm_map_to_entry(map)) {
+		vstart = (uint64_t)entry->vme_start;
+		vend = (uint64_t)entry->vme_end;
+		prot = entry->protection;
+	}
+	vm_map_unlock_read(map);
+
+	printf("ABORT %s[%d] esr 0x%x far 0x%llx elr 0x%llx fc 0x%x ft 0x%x kr %d vme 0x%llx-0x%llx prot %d\n",
+	    p != NULL ? p->p_comm : "?", p != NULL ? proc_getpid(p) : 0,
+	    esr, far, elr, fault_code, (unsigned)fault_type, kr, vstart, vend, prot);
+
+	{
+		extern void sweet_log_flush_now(void);
+
+		sweet_log_flush_now();
+	}
+}
+
