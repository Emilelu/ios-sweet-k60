 #define SWEET_FB_FORMAT_BGRA            0x42475241
 
+/* sweetfb_scale / 内部模式：怎么把逻辑画面铺到面板上 */
+#define SWEET_FB_SCALE_FIT              1       /* 等比放大并居中（默认） */
+#define SWEET_FB_SCALE_FIXED            0       /* 左上 1:1，其余留黑 */
+#define SWEET_FB_SCALE_NATIVE           2       /* 逻辑 == 面板，1:1 全屏 */
+
+/*
+ * 逻辑显示与物理面板之间的几何关系。全是整数运算（step 用 16.16，只用来判
+ * 断"要不要缩放"和打日志；逐像素的累加在 sweet_fb_scale_blit 里用 32.32），
+ * 于是这份坐标数学可以在 x86 上离线单测，不需要手机也不需要 mac。
+ */
+struct sweet_fb_geom {
+	uint32_t panelW, panelH;                /* 面板（真显存）尺寸 */
+	uint32_t logicalW, logicalH;            /* 对外报的尺寸 */
+	uint32_t dstX, dstY, dstW, dstH;        /* 逻辑画面落在面板上的矩形 */
+	uint32_t stepX, stepY;                  /* 16.16：面板 1 像素 = 多少逻辑像素 */
+	uint32_t mode;                          /* SWEET_FB_SCALE_* */
+};
+
+static const char *
+sweet_fb_scale_name(uint32_t mode)
+{
+	if (mode == SWEET_FB_SCALE_FIT) {
+		return "fit";
+	}
+	if (mode == SWEET_FB_SCALE_NATIVE) {
+		return "native";
+	}
+	return "fixed";
+}
+
+/*
+ * 按面板与逻辑尺寸算一次几何。mode 决定铺法：
+ *   FIT     按宽度铺满；若这样高度反而超出面板，改按高度铺满（不裁内容）
+ *   FIXED   左上 1:1
+ *   NATIVE  同上，但尺寸本来就相等
+ */
+static void
+sweet_fb_geom_init(struct sweet_fb_geom *g, uint32_t panelW, uint32_t panelH,
+    uint32_t logicalW, uint32_t logicalH, uint32_t mode)
+{
+	bzero(g, sizeof(*g));
+	g->panelW = panelW;
+	g->panelH = panelH;
+	g->logicalW = logicalW;
+	g->logicalH = logicalH;
+	g->mode = mode;
+	if (panelW == 0 || panelH == 0 || logicalW == 0 || logicalH == 0) {
+		return;
+	}
+	if (mode == SWEET_FB_SCALE_FIT) {
+		uint32_t w = panelW;
+		uint32_t h = (uint32_t)(((uint64_t)logicalH * panelW + logicalW / 2) / logicalW);
+
+		if (h > panelH) {
+			h = panelH;
+			w = (uint32_t)(((uint64_t)logicalW * panelH + logicalH / 2) / logicalH);
+		}
+		g->dstW = w;
+		g->dstH = h;
+		g->dstX = (panelW - w) / 2;
+		g->dstY = (panelH - h) / 2;
+	} else {
+		g->dstW = logicalW < panelW ? logicalW : panelW;
+		g->dstH = logicalH < panelH ? logicalH : panelH;
+		g->dstX = g->dstY = 0;
+	}
+	g->stepX = (uint32_t)(((uint64_t)logicalW << 16) / g->dstW);
+	g->stepY = (uint32_t)(((uint64_t)logicalH << 16) / g->dstH);
+}
+
+/* 逻辑点 -> 面板点（先夹到画布内，所以结果一定落在 dst 矩形里）。 */
+static void
+sweet_fb_geom_map(const struct sweet_fb_geom *g, int32_t lx, int32_t ly,
+    int32_t *px, int32_t *py)
+{
+	if (g->logicalW == 0 || g->logicalH == 0) {
+		if (px != NULL) {
+			*px = 0;
+		}
+		if (py != NULL) {
+			*py = 0;
+		}
+		return;
+	}
+	if (px != NULL) {
+		int64_t x = lx;
+		if (x < 0) {
+			x = 0;
+		}
+		if (x > (int64_t)g->logicalW) {
+			x = g->logicalW;
+		}
+		*px = (int32_t)(g->dstX + (uint32_t)(((uint64_t)x * g->dstW) / g->logicalW));
+	}
+	if (py != NULL) {
+		int64_t y = ly;
+		if (y < 0) {
+			y = 0;
+		}
+		if (y > (int64_t)g->logicalH) {
+			y = g->logicalH;
+		}
+		*py = (int32_t)(g->dstY + (uint32_t)(((uint64_t)y * g->dstH) / g->logicalH));
+	}
+}
+
+/*
+ * 把一个矩形按几何缩放贴进面板（最近邻，CPU 拷贝）。
+ *
+ *   lx,ly,lw,lh  目的矩形，逻辑坐标
+ *   sx,sy,sw,sh  源矩形，源图像像素
+ *   inplace      源就是面板缓冲自己的左上角（CA 直接画在默认 surface 上）：
+ *                目的永远在源的右下方向，所以从右下往左上写，绝不踩到还没
+ *                读的源像素。
+ *
+ * 返回写进面板的像素数。
+ */
+static uint32_t
+sweet_fb_scale_blit(const struct sweet_fb_geom *g, uint8_t *dst, uint32_t dstRowBytes,
+    const uint8_t *src, uint32_t srcRowBytes,
+    int32_t lx, int32_t ly, int32_t lw, int32_t lh,
+    int32_t sx, int32_t sy, int32_t sw, int32_t sh, bool inplace)
+{
+	uint32_t X0, X1, Y0, Y1, cols, rows;
+	uint64_t colStep, rowStep;
+	int64_t x0, x1, y0, y1;
+	uint64_t fx, fy;
+
+	if (g->logicalW == 0 || g->logicalH == 0 || lw <= 0 || lh <= 0 ||
+	    sw <= 0 || sh <= 0 || sx < 0 || sy < 0) {
+		return 0;
+	}
+	/*
+	 * 只裁目的窗口，不动 lx/ly/sw/sh：否则宽高比一变，缩放系数就错了。
+	 * 落在面板/画面外的部分直接不写。
+	 */
+	x0 = (int64_t)g->dstX + ((int64_t)lx * (int64_t)g->dstW) / (int64_t)g->logicalW;
+	x1 = (int64_t)g->dstX + (((int64_t)lx + lw) * (int64_t)g->dstW +
+	    g->logicalW - 1) / (int64_t)g->logicalW;    /* 向上取整，右边不丢一列 */
+	y0 = (int64_t)g->dstY + ((int64_t)ly * (int64_t)g->dstH) / (int64_t)g->logicalH;
+	y1 = (int64_t)g->dstY + (((int64_t)ly + lh) * (int64_t)g->dstH +
+	    g->logicalH - 1) / (int64_t)g->logicalH;
+	if (x0 < (int64_t)g->dstX) {
+		x0 = g->dstX;
+	}
+	if (y0 < (int64_t)g->dstY) {
+		y0 = g->dstY;
+	}
+	if (x1 > (int64_t)(g->dstX + g->dstW)) {
+		x1 = (int64_t)(g->dstX + g->dstW);
+	}
+	if (y1 > (int64_t)(g->dstY + g->dstH)) {
+		y1 = (int64_t)(g->dstY + g->dstH);
+	}
+	if (x0 < 0) {
+		x0 = 0;
+	}
+	if (y0 < 0) {
+		y0 = 0;
+	}
+	if (x1 > (int64_t)g->panelW) {
+		x1 = g->panelW;
+	}
+	if (y1 > (int64_t)g->panelH) {
+		y1 = g->panelH;
+	}
+	if (x1 <= x0 || y1 <= y0) {
+		return 0;
+	}
+	X0 = (uint32_t)x0;
+	X1 = (uint32_t)x1;
+	Y0 = (uint32_t)y0;
+	Y1 = (uint32_t)y1;
+
+	/*
+	 * 面板 1 像素 -> 源像素，32.32 定点：源每逻辑像素 sw/lw，逻辑每面板像素
+	 * LW/dstW。用 32.32 而不是 16.16，是因为 16.16 的截断会在 3118 行里攒出
+	 * 三十来行偏一格；32.32 只剩"正好落在像素边界上"的并列点，肉眼无从分辨。
+	 */
+	colStep = (((uint64_t)(uint32_t)sw << 32) * g->logicalW) /
+	    ((uint64_t)(uint32_t)lw * g->dstW);
+	rowStep = (((uint64_t)(uint32_t)sh << 32) * g->logicalH) /
+	    ((uint64_t)(uint32_t)lh * g->dstH);
+	if (colStep == 0) {
+		colStep = 1;            /* 源比目的窄太多：退化成一列，别死循环 */
+	}
+	if (rowStep == 0) {
+		rowStep = 1;
+	}
+
+	/* 目的矩形左上角对应的源像素（32.32），整个循环从这里开始累加。 */
+	fx = (uint64_t)(uint32_t)sx << 32;
+	fy = (uint64_t)(uint32_t)sy << 32;
+	{
+		int64_t ox = (int64_t)(((uint64_t)(X0 - g->dstX) * g->logicalW) / g->dstW) - lx;
+		int64_t oy = (int64_t)(((uint64_t)(Y0 - g->dstY) * g->logicalH) / g->dstH) - ly;
+
+		if (ox > 0) {
+			fx += ((uint64_t)ox << 32) * (uint64_t)(uint32_t)sw / (uint64_t)(uint32_t)lw;
+		}
+		if (oy > 0) {
+			fy += ((uint64_t)oy << 32) * (uint64_t)(uint32_t)sh / (uint64_t)(uint32_t)lh;
+		}
+	}
+	/*
+	 * 取像素中心（半步偏移）：否则整幅图会往左上偏半格。偏移之后源下标可能
+	 * 探到矩形外一格，下面两处夹一下就好。
+	 */
+	fx += colStep / 2;
+	fy += rowStep / 2;
+
+	cols = X1 - X0;
+	rows = Y1 - Y0;
+	if (!inplace) {
+		const uint32_t maxCol = (uint32_t)sx + (uint32_t)sw - 1;
+		const uint64_t maxRow = (uint64_t)sy + (uint64_t)sh - 1;
+
+		for (uint32_t r = 0; r < rows; r++) {
+			uint64_t srcy = fy >> 32;
+			uint32_t *drow = (uint32_t *)(dst + (uint64_t)(Y0 + r) * dstRowBytes);
+			uint64_t x = fx;
+
+			if (srcy > maxRow) {
+				srcy = maxRow;
+			}
+			const uint32_t *srow = (const uint32_t *)(src + srcy * srcRowBytes);
+			for (uint32_t i = 0; i < cols; i++) {
+				uint32_t c = (uint32_t)(x >> 32);
+
+				if (c > maxCol) {
+					c = maxCol;
+				}
+				drow[X0 + i] = srow[c];
+				x += colStep;
+			}
+			fy += rowStep;
+		}
+	} else {
+		uint64_t row = fy + (uint64_t)(rows - 1) * rowStep;
+		const uint64_t maxRow = (uint64_t)sy + (uint64_t)sh - 1;
+		const uint32_t maxCol = (uint32_t)sx + (uint32_t)sw - 1;
+
+		for (uint32_t r = rows; r > 0; r--) {
+			uint64_t srcy = row >> 32;
+			const uint32_t *srow;
+			uint32_t *drow = (uint32_t *)(dst + (uint64_t)(Y0 + r - 1) * dstRowBytes);
+			uint64_t x = fx + (uint64_t)(cols - 1) * colStep;
+
+			if (srcy > maxRow) {
+				srcy = maxRow;
+			}
+			srow = (const uint32_t *)(src + srcy * srcRowBytes);
+			for (uint32_t i = cols; i > 0; i--) {
+				uint32_t c = (uint32_t)(x >> 32);
+
+				if (c > maxCol) {
+					c = maxCol;
+				}
+				drow[X0 + i - 1] = srow[c];
+				x -= colStep;
+			}
+			row -= rowStep;
+		}
+	}
+	return cols * rows;
+}
+
+/*
+ * 缩放留下的黑边：把 dst 矩形以外的地方刷黑，否则开机画面 / 上一帧的残影
+ * 就留在那儿（1440x3118 上下各 41 行）。必须在贴完图之后再调用：原地放大
+ * 那条路径的源就压在顶栏下面那几行里。
+ */
+static void
+sweet_fb_clear_bars(const struct sweet_fb_geom *g, uint8_t *pixels, uint32_t rowBytes)
+{
+	uint32_t right;
+
+	if (g->dstX == 0 && g->dstY == 0 && g->dstW == g->panelW && g->dstH == g->panelH) {
+		return;         /* 铺满整块，没有黑边 */
+	}
+	right = g->dstX + g->dstW;
+	for (uint32_t y = 0; y < g->panelH; y++) {
+		uint8_t *row = pixels + (uint64_t)y * rowBytes;
+
+		if (y < g->dstY || y >= g->dstY + g->dstH) {
+			bzero(row, (size_t)g->panelW * 4);
+			continue;
+		}
+		if (g->dstX > 0) {
+			bzero(row, (size_t)g->dstX * 4);
+		}
+		if (right < g->panelW) {
+			bzero(row + (uint64_t)right * 4, (size_t)(g->panelW - right) * 4);
+		}
+	}
+}
