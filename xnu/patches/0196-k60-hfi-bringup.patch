+/*
+ * 0194 本体：HFI 握手。
+ *   1. 队列表得先在内存里（正常流程已经在放复位之前准备好）；
+ *   2. 写 HFI_CTRL_INIT=1；
+ *   3. 轮询 HFI_CTRL_STATUS 的 bit0，上限 100 ms（1 us 一次，和 FW_INIT 同款）。
+ * 只有 bit0 置起才算对端收下了 —— 这是 Pong 唯一的判据，没有任何别的 ACK。
+ * 返回码：0 成功；-1 没有窗口/表没准备好；-2 寄存器不在 GMU 窗口里；-3 超时。
+ */
+static int
+sweet_adreno_hfi_init(volatile void *gmu)
+{
+	uint32_t last = 0;
+	int rc;
+	unsigned i;
+
+	if (!sweet_hfi_prepared) {
+		rc = sweet_adreno_hfi_prepare();
+		if (rc != 0) {
+			IOLog("SWEET ADRENO: hfi init failed rc=%d last=%#x (no queue table)\n",
+			    rc, last);
+			return rc;
+		}
+	}
+	if (!SWEET_GMU_FITS(SWEET_GMU_HFI_CTRL_INIT) ||
+	    !SWEET_GMU_FITS(SWEET_GMU_HFI_CTRL_STAT)) {
+		IOLog("SWEET ADRENO: hfi init failed rc=%d last=%#x (ctrl registers outside"
+		    " the gmu window)\n", -2, last);
+		return -2;
+	}
+	IOLog("SWEET ADRENO: hfi ctrl_init=1 qtbl=%#x\n",
+	    (unsigned)SWEET_SMMU_CTX_IOVA_HFI);
+	sweet_adreno_wr(gmu, SWEET_GMU_OFF(SWEET_GMU_HFI_CTRL_INIT), 1);
+	for (i = 0; i < 100000; i++) {
+		last = sweet_adreno_rd(gmu, SWEET_GMU_OFF(SWEET_GMU_HFI_CTRL_STAT));
+		if ((last & 1) != 0) {
