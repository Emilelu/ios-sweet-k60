+/*
+ * 0194 的 boot-arg 门。默认关：0192 在真机上验过的那条路径（一页 hfi、
+ * 不写队列、不等握手）一字不改，只有显式 sweetadreno_hfi=1 才扩映射并握手。
+ * 答案缓存一次 —— smmu_context 决定映射多大、gmu_load 决定做不做握手，
+ * 两处必须看到同一个值，否则映射和用法会对不上。
+ */
+static int
+sweet_adreno_hfi_enabled(void)
+{
+	static int cached = -1;
+	unsigned on = 0;
+
+	if (cached < 0) {
