+	if (sweet_hfi_bytes < SWEET_HFI_BYTES) {
+		IOLog("SWEET ADRENO: hfi prepare: window is %u bytes, Pong's layout needs %u\n",
+		    sweet_hfi_bytes, SWEET_HFI_BYTES);
+		return -2;
+	}
+	for (i = 0; i < SWEET_HFI_BYTES / 4; i++) {
+		sweet_hfi_cpu[i] = 0;
+	}
+	words = sweet_adreno_hfi_table_words((uint32_t *)(uintptr_t)sweet_hfi_cpu,
+	    (uint32_t)SWEET_SMMU_CTX_IOVA_HFI);
