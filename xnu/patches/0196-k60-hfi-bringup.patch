+	    " window=%u\n", (unsigned)SWEET_SMMU_CTX_IOVA_HFI, words, SWEET_HFI_QUEUES,
+	    SWEET_HFI_DATA_BYTES, SWEET_HFI_BYTES);
+	return 0;
+}
