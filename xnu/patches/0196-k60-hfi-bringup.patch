+/*
+ * 纯函数：把 Pong 的 HFI 队列表头写进 table（按 dword 数）。
+ * 不碰 MMIO、不读 boot-arg、不看任何全局状态，离线单测直接拿它和
+ * PongAdrenoHfiInitializeStopped() 逐字段比对。
+ * 返回写进去的 dword 数（SWEET_HFI_TBL_WORDS = 210）；参数不对返回 0。
+ *
+ * 逐字段照抄 PongAdrenoHfi.c 的 shared[]：
+ *   [0]=0 版本（Pong 的 valid() 要求必须是 0）、[1]=210 表长（dword）、
+ *   [2]=6 表头长度、[3]=12 队列头长度、[4]=3 队列数、[5]=3（Pong 这里也写 3，
+ *   不是留零）。每条队列头 v 的 v[0]=1 有效、v[1]=数据区 iova、
+ *   v[2]=(q==2 ? 0x2800 : 0xa00) | q 类型、v[3]=1024 长度、v[4..11]=0。
+ */
+static uint32_t
+sweet_adreno_hfi_table_words(uint32_t *table, uint32_t iova)
+{
+	uint32_t q;
+
+	if (table == NULL || (iova & (SWEET_SMMU_CTX_PAGE - 1)) != 0) {
+		return 0;
+	}
+	for (q = 0; q < SWEET_HFI_TBL_WORDS; q++) {
+		table[q] = 0;
+	}
+	table[0] = 0;
+	table[1] = SWEET_HFI_TBL_WORDS;
+	table[2] = 6;
+	table[3] = SWEET_HFI_QHDR_WORDS;
+	table[4] = SWEET_HFI_QUEUES;
+	table[5] = SWEET_HFI_QUEUES;
+	for (q = 0; q < SWEET_HFI_QUEUES; q++) {
+		uint32_t *v = table + 6 + SWEET_HFI_QHDR_WORDS * q;
+
+		v[0] = 1;
+		v[1] = iova + SWEET_HFI_DATA_OFF + q * SWEET_HFI_WORDS * 4;
+		v[2] = (q == 2 ? 0x2800u : 0xa00u) | q;
+		v[3] = SWEET_HFI_WORDS;
+	}
+	return SWEET_HFI_TBL_WORDS;
+}
