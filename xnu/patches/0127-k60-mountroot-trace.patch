+/* Draw a short string in the fixed trace area (same rows, no scrolling). */
+void
+sweet_fbcon_trace_str(int line, const char *label, const char *text)
+{
+	int n = 0, m = 0;
+	char buf[48];
+
+	if (!fbcon_base || line < 0 || line > 2 || !text) {
+		return;
+	}
+	while (*label && n < 16) {
+		buf[n++] = *label++;
+	}
+	buf[n++] = ':';
+	buf[n++] = ' ';
+	while (*text && n < 46) {
+		buf[n++] = *text++;
+	}
+	for (int i = 0; i < n; i++) {
+		const unsigned char *glyph = iso_font + (unsigned char)buf[i] * 16;
+
+		for (uint32_t gy = 0; gy < 16 * FBCON_SCALE; gy++) {
+			uint32_t sy = gy % FBCON_SCALE, gyy = gy / FBCON_SCALE;
+			volatile uint32_t *p = fbcon_base +
+			    (((uint32_t)line + FBCON_RESERVED) * 16 * FBCON_SCALE + gy) *
+			    (fbcon_stride / 4) + FBCON_MARGIN + (uint32_t)i * 8 * FBCON_SCALE;
+
+			for (uint32_t gx = 0; gx < 8; gx++) {
+				uint32_t px = (glyph[gyy] & (1u << gx)) ? FBCON_FG : FBCON_BG;
+
+				for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
+					p[gx * FBCON_SCALE + sx] = px;
+				}
+			}
+			(void)sy;
+		}
+	}
+	(void)m;
+}
