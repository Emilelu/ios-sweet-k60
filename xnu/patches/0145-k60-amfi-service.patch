+/*
+ * SWEET: launchd_cache_loader (and libamfi) look for an IORegistry service named
+ * "AppleMobileFileIntegrity". The built-in AMFI here is only a MAC policy, so
+ * that lookup failed and launchd_cache_loader aborted with "Unable to find
+ * AMFI", which panicked the system. Publish a minimal service so the name
+ * resolves; the policy above is what actually decides anything.
+ */
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+
+class SweetAMFIService : public IOService {
+	OSDeclareDefaultStructors(SweetAMFIService)
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetAMFIService, IOService)
+
+bool
+SweetAMFIService::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("SWEET AMFI: AppleMobileFileIntegrity published\n");
+	return true;
+}
+
+void
+sweet_amfi_service_publish(void)
+{
+	SweetAMFIService *svc = new SweetAMFIService;
+
+	if (svc == nullptr) {
+		return;
+	}
+	if (!svc->init()) {
+		svc->release();
+		return;
+	}
+	svc->setName("AppleMobileFileIntegrity");
+	if (!svc->attach(IOService::getResourceService())) {
+		svc->release();
+		return;
+	}
+	svc->start(IOService::getResourceService());
+}
