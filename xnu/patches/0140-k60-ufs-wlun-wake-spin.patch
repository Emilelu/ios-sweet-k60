+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	return ufs_scsi_lun(su.lun, cdb, cdb_len, len, write);
+}
+
 /*
  * Retry a command a few times: the first command after the bootloader hands the
  * host over usually comes back CHECK CONDITION (UNIT ATTENTION), and the
  * condition is cleared by the REQUEST SENSE that ufs_scsi() issues.
  */
+/*
+ * ~10 ms of CPU spins. Calibrated by feel, not by the timer: what matters is
+ * that the loop really consumes time, which the tick counter cannot guarantee.
+ */
+static void
+ufs_spin_wait(void)
+{
+	for (volatile uint32_t i = 0; i < 4000000u; i++) {
+		__asm__ volatile("" ::: "memory");
+	}
+}
+
 static int
 ufs_scsi_retry(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 {
 	int err = EIO;
 
 	/*
-	 * A UFS device answers NOT READY / "logical unit is in process of becoming
-	 * ready" (sense key 0x2, ASC 0x04, ASCQ 0x02) for a few seconds after power
-	 * on. Keep asking: this is the difference between "no root" and a working
-	 * disk on this platform.
+	 * The timer interrupt has never been observed on this board, so delay() and
+	 * mach_absolute_time() cannot be trusted here: every wait below is a plain
+	 * CPU spin. mondrian's notes are explicit about this.
 	 */
-	for (int attempt = 0; attempt < 600; attempt++) {
+	for (int attempt = 0; attempt < 400; attempt++) {
 		err = ufs_scsi(cdb, cdb_len, len, write);
 		if (err == 0) {
 			if (attempt) {
@@ -304,7 +321,7 @@
 			}
 			break;
 		}
-		delay(50);      /* up to thirty seconds in total */
+		ufs_spin_wait();
 	}
 	return err;
 }
@@ -689,13 +706,18 @@
