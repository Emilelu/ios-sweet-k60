-		/* START STOP UNIT with START=1: some UFS devices sit in "becoming ready"
-		 * until they are told to spin up. */
+		/*
+		 * The device sits in PowerDown (bCurrentPowerMode 0x33). The wake is
+		 * START STOP UNIT with the power condition in the high nibble of byte 4
+		 * (0x10 = active), addressed to the UFS well-known LUN 0xd0 - not to the
+		 * data LUN. Both details come from the mondrian bring-up notes.
+		 */
 		{
-			uint8_t ssu[6] = { 0x1b, 0, 0, 0, 0x01, 0 };
-			int ssu_error = ufs_scsi(ssu, sizeof(ssu), 0, false);
+			uint8_t ssu[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+			int ssu_error = ufs_scsi_lun(0xd0, ssu, sizeof(ssu), 0, false);
 
-			printf("SWEET UFS: START STOP UNIT rc %d\n", ssu_error);
+			printf("SWEET UFS: wake START STOP UNIT (wlun 0xd0) rc %d\n", ssu_error);
+			ufs_spin_wait();
 		}
 
 		/* The first command after the bootloader may report a unit attention. */
