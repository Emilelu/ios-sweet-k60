+ * 读回已经是 1 就一个字都不写 —— 正常路径下这就是全部动作；不是 1 才写一次、
+ * 再读回来确认。放复位之前还要再调一次：入口那次读只证明"刚才"是按着的，
+ * 中间还隔着几百条 TCM 与配置写。
+ */
+static int
+sweet_adreno_gmu_hold_reset(volatile void *gmu, const char *when)
+{
+	uint32_t off = SWEET_GMU_OFF(SWEET_GMU_CM3_SYSRESET);
+	uint32_t before = sweet_adreno_rd(gmu, off);
+
+	if (before == 1) {
+		IOLog("SWEET ADRENO: [%s] CM3 already held in reset (%#x), write skipped\n",
+		    when, before);
+		return 0;
+	}
+	sweet_adreno_wr(gmu, off, 1);
+	{
+		uint32_t after = sweet_adreno_rd(gmu, off);
+
+		if (after != 1) {
+			IOLog("SWEET ADRENO: [%s] CM3_SYSRESET=1 did not stick (was %#x, now %#x)\n",
+			    when, before, after);
+			return -1;
+		}
+	}
+	IOLog("SWEET ADRENO: [%s] CM3_SYSRESET asserted, read back 1 (was %#x)\n",
+	    when, before);
+	return 0;
