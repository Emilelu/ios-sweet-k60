+/*
+ * 0208：四个 GBIF QSB side（ShengGmu.c:171 的那行 for 循环）。
+ * 写到 GPU（kgsl）窗口，字节偏移 = dword 序号 * 4，写完逐条读回。
+ */
+static int
+sweet_adreno_gmu_write_gbif(volatile void *kgsl)
+{
+	for (unsigned i = 0; i < SWEET_KGSL_GBIF_QSB_SIDES; i++) {
+		uint32_t dword = SWEET_KGSL_GBIF_QSB_SIDE0 + i;
+		uint32_t off = dword * 4u;
+		uint32_t got;
+
+		if (off + 4 > SWEET_KGSL_SIZE) {
+			IOLog("SWEET ADRENO: gbif side%u offset %#x outside the kgsl window\n",
+			    i, off);
+			return -1;
+		}
+		sweet_adreno_wr(kgsl, off, SWEET_GBIF_QSB_SIDE_VALUE);
+		got = sweet_adreno_rd(kgsl, off);
+		IOLog("SWEET ADRENO: gbif qsb side%u kgsl dword %#x (byte %#x) = %#x, read %#x\n",
+		    i, dword, off, SWEET_GBIF_QSB_SIDE_VALUE, got);
+		if (got != SWEET_GBIF_QSB_SIDE_VALUE) {
+			return -1;
+		}
+	}
+	return 0;
+}
