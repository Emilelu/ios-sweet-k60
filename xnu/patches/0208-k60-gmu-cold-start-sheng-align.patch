+/*
+ * 0208：FW_INIT 的判据随固件代次变（ShengGmu.c:174-175，与 Linux
+ * a6xx_gmu_start 里那段 if (val <= 0x20010004) 完全同款）：
+ *   老固件（版本字 <= 0x20010004）成功时整字写魔数 0xbabeface，只能整字比；
+ *   新固件写状态字，比低 9 位 == 0x100（0187 起的判据）。
+ * 单独拆成函数是为了让两条分支都能在仿真台里被直接调到。
+ */
+static void
+sweet_adreno_gmu_fwinit_criterion(uint32_t version, uint32_t *mask, uint32_t *ready)
+{
+	if (version <= SWEET_GMU_FW_LEGACY_MAX) {
+		*mask = 0xffffffffu;
+		*ready = SWEET_GMU_FWINIT_MAGIC;
+	} else {
+		*mask = SWEET_GMU_FWINIT_MASK;
+		*ready = SWEET_GMU_FWINIT_READY;
+	}
+}
