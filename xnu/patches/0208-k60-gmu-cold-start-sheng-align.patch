+/*
+ * 0208：放复位之前的配置回读（ShengGmu.c:184-187）。
+ * 写进去不等于落到寄存器上：窗口映射错、位宽错、或者哪一条被硬件自己改写，
+ * 这里是最后一次能拦下来的地方 —— 放复位之后出问题就只剩整机复位。
+ * 需要 SMMU context 才有真地址的那两条（QTBL_ADDR / GENERAL_8）只在
+ * context 建好时才校验，否则校验的是"没写过的 0"。
+ */
+static int
+sweet_adreno_gmu_verify_config(volatile void *gmu, int with_ctx)
+{
+	static const struct {
+		uint32_t reg, value;
+		const char *what;
+		int needs_ctx;
+	} verify[] = {
+		{ SWEET_GMU_CM3_FW_INIT, 0, "fw_init_result", 0 },
+		{ SWEET_GMU_CM3_BOOT_CFG, 2, "boot_config", 0 },
+		{ SWEET_GMU_HFI_QTBL_ADDR, SWEET_GMU_HFI_QTBL_IOVA, "qtbl_addr", 1 },
+		{ SWEET_GMU_HFI_QTBL_INFO, 1, "qtbl_info", 0 },
+		{ SWEET_GMU_AHB_FENCE_0, 0x80c808a0u, "ahb_fence", 0 },
+		{ SWEET_GMU_CM3_CFG, 0x4052, "cm3_cfg", 0 },
+		{ SWEET_GMU_GENERAL_10, SWEET_GMU_CHIP_ID, "chip_id", 0 },
+		{ SWEET_GMU_GENERAL_8, SWEET_GMU_LOG_IOVA | 3u, "general_8", 1 },
+		{ SWEET_GMU_SYS_BUS_CFG, 1, "sys_bus_cfg", 0 },
+		{ SWEET_GMU_ICACHE_CFG, 1, "icache_cfg", 0 },
+		{ SWEET_GMU_DCACHE_CFG, 1, "dcache_cfg", 0 },
+	};
+	unsigned checked = 0, bad = 0;
+
+	for (unsigned i = 0; i < sizeof(verify) / sizeof(verify[0]); i++) {
+		uint32_t got;
+
+		if (!SWEET_GMU_FITS(verify[i].reg)) {
+			continue;
+		}
+		if (verify[i].needs_ctx && !with_ctx) {
+			continue;
+		}
+		got = sweet_adreno_rd(gmu, SWEET_GMU_OFF(verify[i].reg));
+		checked++;
+		if (got != verify[i].value) {
+			IOLog("SWEET ADRENO: config readback %s = %#x, want %#x\n",
+			    verify[i].what, got, verify[i].value);
+			bad++;
+		}
+	}
+	if (bad != 0) {
+		IOLog("SWEET ADRENO: %u of %u config registers did not read back;"
+		    " CM3 stays in reset\n", bad, checked);
+		return -1;
+	}
+	IOLog("SWEET ADRENO: config readback ok, %u registers matched\n", checked);
+	return 0;
+}
