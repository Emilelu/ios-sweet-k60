+/*
+ * 0201：GPU RSC 上电握手，逐条照抄厂商的 gen7_rscc_wakeup_sequence()
+ * （msm_kgsl.ko 0x7c014）：
+ *
+ *   write A[0x23b07] = 2            上电请求
+ *   poll  A[0x23b08] bit1 == 1      应答；超时 100 ms
+ *   ...   poll RSCC[0x101] == 0     由 rscc_sequence 里那条 busy 读接着做
+ *   write A[0x23b07] = 0            撤请求
+ *
+ * 失败串是 "Failed to do GPU RSC power on" / "GPU RSC sequence stuck in
+ * waking up GPU"。厂商只在 warm boot 路径（gen7_gmu_boot）做这一步，
+ * first_boot 不做 —— 前提是 bootloader 已经把 RSC 拉起来过。我们这台 iOS
+ * 冷启动到这一刻，ABL 早就没人投票了，RSC 已经睡回去，所以必须先握手。
+ *
+ * 只写 GMU 窗口（0x26C1C/0x26C20 都在已映射的 0x37000 里），因此"RSC 醒没醒"
+ * 这件事可以在完全不碰 RSCC 的前提下问清楚 —— 这正是本补丁想要的顺序：
+ * 唤醒不通就一行 RSCC 都不读不写。
+ *
+ * 两处与厂商不同，上机时要盯：
+ *   - 厂商第 5 步（RSCC 空闲后写回 0 撤请求）本补丁没做：撤了可能让 RSC 又
+ *     睡回去，而我们从不下电 GPU；RSCC+0x404 的忙闲判据在 rscc_sequence 里
+ *     照旧保留，真机上如果"写完微码没生效"，第一个该补的就是这条撤请求。
+ *   - 轮询用 1 us 的 delay，厂商用 usleep_range；机器上只有 us 粒度。
+ * 返回值：0 = 应答位起来了；-1 = 超时或窗口不对（调用方必须停）。
+ */
+static int
+sweet_adreno_rsc_wakeup(volatile void *gmu)
+{
+	uint32_t req, ack, last = 0;
+	unsigned polls;
+
+	if (gmu == NULL) {
+		IOLog("SWEET ADRENO: rsc wakeup needs the gmu window, none mapped\n");
+		return -1;
+	}
+	if (!SWEET_GMU_FITS(SWEET_GMU_RSC_POWER_REQ) ||
+	    !SWEET_GMU_FITS(SWEET_GMU_RSC_POWER_ACK)) {
+		IOLog("SWEET ADRENO: rsc wakeup dwords %#x/%#x fall outside the %#x"
+		    " gmu window\n", (unsigned)SWEET_GMU_RSC_POWER_REQ,
+		    (unsigned)SWEET_GMU_RSC_POWER_ACK, (unsigned)SWEET_GMU_SIZE);
+		return -1;
+	}
+	req = SWEET_GMU_OFF(SWEET_GMU_RSC_POWER_REQ);
+	ack = SWEET_GMU_OFF(SWEET_GMU_RSC_POWER_ACK);
+	IOLog("SWEET ADRENO: rsc wakeup: gmu+%#x <- 2 (dword %#x), then poll"
+	    " gmu+%#x bit1 for %u us\n", req, (unsigned)SWEET_GMU_RSC_POWER_REQ,
+	    ack, (unsigned)SWEET_RSC_WAKEUP_US);
+	sweet_adreno_wr(gmu, req, 2);
+	for (polls = 1; polls <= SWEET_RSC_WAKEUP_US; polls++) {
+		last = sweet_adreno_rd(gmu, ack);
+		if ((last & 2u) != 0) {
+			IOLog("SWEET ADRENO: rsc awake after %u polls (gmu+%#x=%#x)\n",
+			    polls, ack, last);
+			return 0;
+		}
+		delay(1);
+	}
+	IOLog("SWEET ADRENO: rsc wakeup timeout last=%#x (gmu+%#x bit1 never came"
+	    " up in %u polls); GPU RSC stuck in waking up\n", last, ack, polls - 1);
+	return -1;
+}
