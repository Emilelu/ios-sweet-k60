 		if (k60_se == 0) {
 			*problem = "cannot map se4";
 			return -1;
@@ -487,14 +490,14 @@ k60_touch_geni_bringup(uint32_t hz, const char **problem)
 	/* 四根线交给 QUP；CS 上拉，MISO/MOSI/CLK 不拉。 */
