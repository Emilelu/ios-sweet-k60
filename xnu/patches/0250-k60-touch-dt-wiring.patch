diff --git a/bsd/dev/k60_touch_dt.c b/bsd/dev/k60_touch_dt.c
new file mode 100755
index 0000000..77a3dd9
--- /dev/null
+++ b/bsd/dev/k60_touch_dt.c
@@ -0,0 +1,138 @@
+/*
+ * K60（mondrian，SM8475）触摸：从 ADT 的 /k60-touch 节点取接线（0250）。
+ *
+ * 0240-0243 把三个窗口、三根控制线、坐标上限全写死在 bsd/sys/k60_touch.h。
+ * 这对第一轮上机是对的（少一层解析就少一个失败点），但板级事实现在有两个
+ * 副本：驱动的宏，和 tools/mkadt.py 里那张表。这个文件把驱动那一侧改成
+ * "节点优先、宏兜底"：
+ *
+ *   /k60-touch 有     -> 用它，并打一行 "K60 TOUCH: dt: ..." 记录实际值
+ *   /k60-touch 没有   -> 用宏，打 "dt: no /k60-touch node"，行为与 0248 相同
+ *
+ * 节点只描述这一颗触摸控制器需要的东西：SE4 / GCC / TLMM 三个窗口（一个
+ * reg 里三对 base/size），reset / irq / avdd 三个 GPIO，坐标上限，SPI 上限。
+ * 故意不写 RSC：那块在这台机器上不可达（0248），驱动走 k60rpmhoff=1 时
+ * 连映射都不做。
+ *
+ * 判据行：
+ *   "K60 TOUCH: dt: se ... gcc ... tlmm ... gpio reset .. irq .. avdd .."
+ *   "K60 TOUCH: dt: no /k60-touch node, compiled wiring (...)"
+ *   "K60 TOUCH: dt: /k60-touch has no usable reg, keeping compiled windows"
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/k60_touch.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+/*
+ * 编译期缺省。逐项与 0240-0243 里写死的值相同，所以节点缺席时行为不变。
+ * .from_dt = 0 是"这些不是从节点读来的"的标记，日志里会打出来。
+ */
+struct k60_touch_wiring k60_touch_hw = {
+	.se_base = K60_TOUCH_SE_BASE,
+	.se_window = K60_TOUCH_SE_WINDOW,
+	.gcc_base = K60_TOUCH_GCC_BASE,
+	.gcc_window = K60_TOUCH_GCC_WINDOW,
+	.tlmm_base = K60_TOUCH_TLMM_BASE,
+	.tlmm_stride = K60_TOUCH_TLMM_STRIDE,
+	.gpio_clk = K60_TOUCH_GPIO_CLK,
+	.gpio_mosi = K60_TOUCH_GPIO_MOSI,
+	.gpio_miso = K60_TOUCH_GPIO_MISO,
+	.gpio_cs = K60_TOUCH_GPIO_CS,
+	.gpio_reset = K60_TOUCH_GPIO_RESET,
+	.gpio_irq = K60_TOUCH_GPIO_IRQ,
+	.gpio_avdd = K60_TOUCH_GPIO_AVDD,
+	.panel_max_x = K60_TOUCH_ABS_MAX_X,
+	.panel_max_y = K60_TOUCH_ABS_MAX_Y,
+	.spi_hz = K60_TOUCH_SPI_HZ,
+	.irq = 605,
+	.from_dt = 0,
+};
+
+/* ADT 的属性是 4 字节小端；x86 和 arm64 都是小端，直接拷。 */
+static int
+k60_dt_u32(DTEntry node, const char *name, uint32_t *out)
+{
+	void const *value = NULL;
+	unsigned int size = 0;
+
+	if (SecureDTGetProperty(node, name, &value, &size) != kSuccess ||
+	    value == NULL || size < sizeof(uint32_t)) {
+		return -1;
+	}
+	memcpy(out, value, sizeof(*out));
+	return 0;
+}
+
+int
+k60_touch_wiring_load(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	uint32_t value;
+
+	if (SecureDTLookupEntry(NULL, "/k60-touch", &node) != kSuccess) {
+		printf("K60 TOUCH: dt: no /k60-touch node, compiled wiring "
+		    "(se %#lx gcc %#lx tlmm %#lx, gpio %u/%u/%u)\n",
+		    (unsigned long)k60_touch_hw.se_base,
+		    (unsigned long)k60_touch_hw.gcc_base,
+		    (unsigned long)k60_touch_hw.tlmm_base,
+		    k60_touch_hw.gpio_reset, k60_touch_hw.gpio_irq,
+		    k60_touch_hw.gpio_avdd);
+		k60_touch_flush();
+		return -1;
+	}
+
+	/* reg = <se base, se size, gcc base, gcc window, tlmm base, stride> */
+	if (SecureDTGetProperty(node, "reg", (void const **)&reg, &size) ==
+	    kSuccess && reg != NULL && size >= 6 * sizeof(uintptr_t)) {
+		k60_touch_hw.se_base = reg[0];
+		k60_touch_hw.se_window = (uint32_t)reg[1];
+		k60_touch_hw.gcc_base = reg[2];
+		k60_touch_hw.gcc_window = (uint32_t)reg[3];
+		k60_touch_hw.tlmm_base = reg[4];
+		k60_touch_hw.tlmm_stride = (uint32_t)reg[5];
+	} else {
+		printf("K60 TOUCH: dt: /k60-touch has no usable reg, keeping "
+		    "compiled windows\n");
+		k60_touch_flush();
+	}
+
+	if (k60_dt_u32(node, "goodix,reset-gpio", &value) == 0) {
+		k60_touch_hw.gpio_reset = value;
+	}
+	if (k60_dt_u32(node, "goodix,irq-gpio", &value) == 0) {
+		k60_touch_hw.gpio_irq = value;
+	}
+	if (k60_dt_u32(node, "goodix,avdd-gpio", &value) == 0) {
+		k60_touch_hw.gpio_avdd = value;
+	}
+	if (k60_dt_u32(node, "goodix,panel-max-x", &value) == 0 && value != 0) {
+		k60_touch_hw.panel_max_x = value;
+	}
+	if (k60_dt_u32(node, "goodix,panel-max-y", &value) == 0 && value != 0) {
+		k60_touch_hw.panel_max_y = value;
+	}
+	if (k60_dt_u32(node, "spi-max-frequency", &value) == 0 && value != 0) {
+		k60_touch_hw.spi_hz = value;
+	}
+	k60_touch_hw.from_dt = 1;
+
+	printf("K60 TOUCH: dt: se %#lx+%#x gcc %#lx+%#x tlmm %#lx/%#x "
+	    "gpio reset %u irq %u avdd %u spi %u Hz axes %u x %u\n",
+	    (unsigned long)k60_touch_hw.se_base, k60_touch_hw.se_window,
+	    (unsigned long)k60_touch_hw.gcc_base, k60_touch_hw.gcc_window,
+	    (unsigned long)k60_touch_hw.tlmm_base, k60_touch_hw.tlmm_stride,
+	    k60_touch_hw.gpio_reset, k60_touch_hw.gpio_irq,
+	    k60_touch_hw.gpio_avdd, k60_touch_hw.spi_hz,
+	    k60_touch_hw.panel_max_x, k60_touch_hw.panel_max_y);
+	k60_touch_flush();
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
