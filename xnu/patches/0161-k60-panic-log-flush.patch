--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -959,6 +959,53 @@
 	printf("\nSWEET LOG: end of previous boot log\n");
 }
 
+/*
+ * SWEET: flush the console ring synchronously. Called from panic() so the boot
+ * that dies still leaves its log on the partition; the periodic thread cannot
+ * help once we are panicking.
+ */
+void
+sweet_log_flush_now(void)
+{
+	uint64_t base;
+	void *bounce;
+	uint64_t total, pos;
+	uint32_t seq = 1;
+
+	if (!su.ready || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	bounce = (void *)(su.dma + DMA_BOUNCE);
+	total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total == 0) {
+		return;
+	}
+	pos = total >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : 0;
+	while (pos < total) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN((uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		if (ufs_write_blocks(base + 1 + blk, n)) {
+			return;
+		}
+		pos += (uint64_t)n * UFS_BLOCK;
+	}
+	{
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = seq,
+		};
+
+		memcpy(bounce, &h, sizeof(h));
+		(void)ufs_write_blocks(base, 1);
+		(void)ufs_sync_cache();
+	}
+}
+
 static void
 sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -972,6 +972,17 @@
 {
 	va_list panic_str_args;
 
+	/*
+	 * SWEET: push the console ring to the partition before we die. The
+	 * periodic flusher cannot run from here, and the panel is the only other
+	 * copy - which is why every panic so far had to be photographed.
+	 */
+	{
+		extern void sweet_log_flush_now(void);
+
+		sweet_log_flush_now();
+	}
+
 	va_start(panic_str_args, str);
 	panic_trap_to_debugger(str, &panic_str_args, 0, NULL, 0, NULL, (unsigned long)(char *)__builtin_return_address(0));
 	va_end(panic_str_args);
