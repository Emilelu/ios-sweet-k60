+/*
+ * Retry a command a few times: the first command after the bootloader hands the
+ * host over usually comes back CHECK CONDITION (UNIT ATTENTION), and the
+ * condition is cleared by the REQUEST SENSE that ufs_scsi() issues.
+ */
+static int
+ufs_scsi_retry(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	int err = EIO;
+
+	for (int attempt = 0; attempt < 5; attempt++) {
+		err = ufs_scsi(cdb, cdb_len, len, write);
+		if (err == 0) {
+			break;
+		}
+		delay(10);
+	}
+	return err;
+}
