+		 * swap 之前就死，异常正是这个）。
+		 */
+		uint32_t cw = fLogicalW, ch = fLogicalH;
+		OSData *dw = OSData::withBytes(&cw, sizeof(cw));
+		OSData *dh = OSData::withBytes(&ch, sizeof(ch));
+
+		if (dw != NULL && dh != NULL) {
+			provider->setProperty("canvas-width", dw);
+			provider->setProperty("canvas-height", dh);
+		}
+		if (dw != NULL) {
+			dw->release();
+		}
+		if (dh != NULL) {
+			dh->release();
+		}
 	}
