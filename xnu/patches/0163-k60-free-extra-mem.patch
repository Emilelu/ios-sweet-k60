--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1652,6 +1652,33 @@
 	arm64_replace_bootstack(&BootCpuData);
 	ml_static_mfree(phystokv(segBOOTDATAB - gVirtBase + gPhysBase), segSizeBOOTDATA);
 
+	/*
+	 * SWEET: hand the clean blocks that sit above the ADT's dram window but
+	 * inside the physmap to the VM. The low DDR bank is 2 GiB accessible with
+	 * 603 MiB of firmware reservations scattered through it, so one contiguous
+	 * managed window only reaches 703 MiB; this adds the block above it.
+	 * sweetfreemem=0 disables the handoff.
+	 */
+	{
+		static const struct {
+			uint64_t base, size;
+		} extra[] = {
+			{ 0xea000000ULL, 0x16000000ULL },   /* 352 MiB, above the QHEE/QTEE block */
+		};
+		int on = 1;
+
+		PE_parse_boot_argn("sweetfreemem", &on, sizeof(on));
+		for (unsigned i = 0; on && i < sizeof(extra) / sizeof(extra[0]); i++) {
+			if (extra[i].base >= gPhysBase &&
+			    extra[i].base + extra[i].size <= gPhysBase + real_phys_size) {
+				ml_static_mfree(phystokv(extra[i].base), extra[i].size);
+				printf("SWEET MEM: handed %#llx+%#llx to the VM\n",
+				    (unsigned long long)extra[i].base,
+				    (unsigned long long)extra[i].size);
+			}
+		}
+	}
+
 #if __ARM_KERNEL_PROTECT__
 	arm_vm_populate_kernel_el0_mappings();
 #endif /* __ARM_KERNEL_PROTECT__ */
