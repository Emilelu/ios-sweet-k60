+/*
+ * 0205：纯软件走表。
+ *
+ * 表是我们自己刚写完的，所以可以像 SMMU 那样从根开始一级一级读描述符，
+ * 把一个 iova 翻成 pa，再回答三个问题：每一级都有描述符吗？最后一级是 4K
+ * 页描述符（而不是 0 或 block）吗？翻出来的 pa 落在我们那块数据块里吗？
+ *
+ * 这一整套不碰任何 MMIO，因此可以在放复位之前、在仿真台上把它跑到底；
+ * 0205 之前"16 MB 到底盖没盖住 0x100000"只能靠上机，一次整机复位换一行日志。
+ *
+ * 返回 0 表示这一条 iova 有有效映射；负数指出断在哪一级：
+ *   -1 中间描述符缺失或不是表指针 -2 子表落出表池 -3 末级不是可用的 4K leaf
+ *   -4 leaf 指向数据块之外       -5 leaf 的属性不是 MAIR index0（NC）
+ */
+static int
+sweet_adreno_smmu_ctx_walk(const uint64_t *tables, uint64_t pool_pa, unsigned capacity,
+    uint64_t data_pa, uint64_t data_bytes, uint64_t va, int verbose)
+{
+	const uint64_t entry_mask = 0x0000fffffffff000ULL;
+	uint64_t limit = pool_pa + (uint64_t)capacity * SWEET_SMMU_CTX_PAGE;
+	uint64_t desc[4] = { 0, 0, 0, 0 };
+	uint64_t pa = 0;
+	unsigned slot[4] = { 0, 0, 0, 0 };
+	unsigned table = 0, level;
+	int rc = 0;
+
+	for (level = SWEET_SMMU_CTX_START_LEVEL; level < 3; level++) {
+		unsigned shift = 39 - 9 * level;
+		unsigned width = (level == SWEET_SMMU_CTX_START_LEVEL) ?
+		    SWEET_SMMU_CTX_INPUT_BITS - shift : 9;
+		uint64_t child;
+
+		slot[level] = (unsigned)((va >> shift) & ((1ULL << width) - 1));
+		desc[level] = tables[table * 512 + slot[level]];
+		/* 只接受表指针（[1:0]=11）：0 是空洞，block 说明有人绕过了 4K 逐页。 */
+		if ((desc[level] & 3) != 3) {
+			rc = -1;
+			break;
+		}
+		child = desc[level] & entry_mask;
+		if (child < pool_pa || child >= limit ||
+		    (child - pool_pa) % SWEET_SMMU_CTX_PAGE != 0) {
+			rc = -2;
+			break;
+		}
+		table = (unsigned)((child - pool_pa) / SWEET_SMMU_CTX_PAGE);
+	}
+	if (rc == 0) {
+		slot[3] = (unsigned)((va >> 12) & 511);
+		desc[3] = tables[table * 512 + slot[3]];
+		pa = desc[3] & entry_mask;
+		if ((desc[3] & 3) != 3) {
+			rc = -3;                      /* 没有 leaf 或不是页描述符 */
+		} else if ((desc[3] & (1ULL << 10)) == 0) {
+			rc = -3;                      /* AF 没置：一访问就 fault */
+		} else if ((pa & (SWEET_SMMU_CTX_PAGE - 1)) !=
+		    (va & (SWEET_SMMU_CTX_PAGE - 1))) {
+			rc = -3;                      /* 页内偏移对不上 */
+		} else if (pa < data_pa || pa >= data_pa + data_bytes) {
+			rc = -4;                      /* 指到我们这块内存之外 */
+		} else if (((desc[3] >> 2) & 7) != 0) {
+			rc = -5;                      /* 不是 NC：和 MAIR0 的 index0 不符 */
+		}
+	}
+	if (verbose) {
+		IOLog("SWEET ADRENO: ctxwalk iova=%#llx: l1[%u]=%#llx l2[%u]=%#llx"
+		    " l3[%u]=%#llx -> pa=%#llx rc=%d%s\n", (unsigned long long)va,
+		    slot[1], (unsigned long long)desc[1], slot[2],
+		    (unsigned long long)desc[2], slot[3], (unsigned long long)desc[3],
+		    (unsigned long long)pa, rc, rc == 0 ? " (valid leaf)" : " (HOLE)");
+	}
+	return rc;
+}
