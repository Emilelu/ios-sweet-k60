+/*
+ * M3 的活儿搬到内核线程里晚点做。
+ *
+ * 原因很实际：kext 的 start() 在 bsd_init 之前跑，那时候 UFS 日志线程还没起来，
+ * 一旦放复位把整机弄复位，日志环里的东西是没人写的 —— 上一轮 gmu=2 就是这样
+ * 一个字都没留下。晚 N 秒再动，日志线程已经在每 5 秒落盘，崩之前的那几行就
+ * 能捞出来；这时 root 也挂上了，sweet_log_flush_now() 才真的有用。
+ */
+struct sweet_adreno_work {
+	volatile void *gpucc;
+	volatile void *gmu;
+	volatile void *kgsl;
+	unsigned gmu_mode;
+	unsigned smmu;
+	unsigned delay_ms;
+};
+
+static struct sweet_adreno_work sweet_work;
+
+static void
+sweet_adreno_do_work(struct sweet_adreno_work *w)
+{
+	if (w->gmu_mode != 0) {
+		int grc = sweet_adreno_gmu_load(w->gpucc, w->gmu, w->kgsl, w->gmu_mode);
+
+		IOLog("SWEET ADRENO: gmu load returned %d\n", grc);
+		sweet_adreno_snapshot(w->gpucc, w->gmu, grc == 0 ? "post-gmu-ok" : "post-gmu-fail");
+		sweet_adreno_gmu_state(w->gmu);
+	}
+	if (w->smmu != 0) {
+		sweet_adreno_smmu_probe();
+	}
+	IOLog("SWEET ADRENO: deferred work done (gmu=%u smmu=%u)\n", w->gmu_mode, w->smmu);
+}
+
+static void
+sweet_adreno_work_thread(void *arg, wait_result_t result)
+{
+	struct sweet_adreno_work *w = (struct sweet_adreno_work *)arg;
+
+	(void)result;
+	IOLog("SWEET ADRENO: deferred work waits %u ms (log thread runs every 5 s by then)\n",
+	    w->delay_ms);
+	IOSleep(w->delay_ms);
+	IOLog("SWEET ADRENO: deferred work starts now\n");
+	sweet_adreno_do_work(w);
+}
+
