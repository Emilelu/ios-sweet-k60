+	ack = sweet_adreno_rd(gmu, SWEET_GMU_RSC_ACK_BYTE);
+	poll = sweet_adreno_rd(gmu, SWEET_GMU_RSC_POLL_BYTE);
+	IOLog("SWEET ADRENO: gmupoke gmu+%#x (pa %#llx) = %#x bit1=%u;"
+	    " gmu+%#x (pa %#llx) = %#x\n",
+	    (unsigned)SWEET_GMU_RSC_ACK_BYTE,
+	    (unsigned long long)sweet_adreno_gmu_pa(SWEET_GMU_RSC_ACK_BYTE), ack,
+	    (ack & 2u) ? 1u : 0u, (unsigned)SWEET_GMU_RSC_POLL_BYTE,
+	    (unsigned long long)sweet_adreno_gmu_pa(SWEET_GMU_RSC_POLL_BYTE), poll);
