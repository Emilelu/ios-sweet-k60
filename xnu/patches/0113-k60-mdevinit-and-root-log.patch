+	 */
+	{
+		extern void mdevinit(int);
+		mdevinit(0);
+	}
+
 	err = IOFindBSDRoot(rootdevice, sizeof(rootdevice), &rootdev, &flags);
+	printf("SWEET: IOFindBSDRoot rc=%d rootdevice='%s' rootdev=0x%x flags=0x%x\n",
+	    err, rootdevice, (unsigned)rootdev, flags);
 	if (err) {
 		printf("setconf: IOFindBSDRoot returned an error (%d);"
