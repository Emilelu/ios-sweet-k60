+			return -1;
+		}
+	}
+
 	for (unsigned s = 0; s < sweet_gmu_fw_seg_count; s++) {
 		const unsigned char *src = sweet_gmu_fw + sweet_gmu_fw_seg[s].off;
 		uint32_t seg_addr = sweet_gmu_fw_seg[s].addr;
@@ -2015,6 +2294,12 @@ SweetAdreno::start(IOService *provider)
 
 	PE_parse_boot_argn("sweetadreno_smmu", &smmu_want, sizeof(smmu_want));
 	PE_parse_boot_argn("sweetadreno_smmuctx", &ctx_want, sizeof(ctx_want));
+	/* 预序列长在 gmu_load 里，所以只开 rscc 不开 gmu 时它不会跑；说清楚，
