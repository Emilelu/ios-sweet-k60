  * sweetfb_native=1 则逻辑尺寸 = 面板尺寸，等于完全不做缩放。
  */
-#define SWEET_FB_LOGICAL_W              1170
-#define SWEET_FB_LOGICAL_H              2532
+#define SWEET_FB_LOGICAL_W              1440
+#define SWEET_FB_LOGICAL_H              3200
 #define SWEET_FB_FORMAT_BGRA            0x42475241
 
 /* sweetfb_scale / 内部模式：怎么把逻辑画面铺到面板上 */
@@ -396,6 +403,73 @@
 
 OSDefineMetaClassAndStructors(IOMobileFramebuffer, IOService);
 
+/*
+ * CA 读显示模式用的是 TimingElements / ColorElements 这两个属性，
+ * 没有它们这块屏"没有模式"，一帧都不提交。ID 要和 GetBlock(0x40) 一致。
+ */
+static void
+sweet_fb_set_number(OSDictionary *dict, const char *key, uint32_t value)
+{
+	OSNumber *n = OSNumber::withNumber(value, 32);
+	if (n != NULL) {
+		dict->setObject(key, n);
+		n->release();
+	}
+}
+
+static void
+sweet_fb_publish_modes(IOService *fb, uint32_t width, uint32_t height)
+{
+	OSDictionary *timing = OSDictionary::withCapacity(8);
+	OSDictionary *horizontal = OSDictionary::withCapacity(4);
+	OSDictionary *vertical = OSDictionary::withCapacity(4);
+	OSDictionary *color = OSDictionary::withCapacity(8);
+	OSArray *timings = OSArray::withCapacity(1);
+	OSArray *colors = OSArray::withCapacity(1);
+	const uint32_t rate = SWEET_FB_REFRESH_HZ << 16;
+
+	if (timing == NULL || horizontal == NULL || vertical == NULL || color == NULL ||
+	    timings == NULL || colors == NULL) {
+		goto done;
+	}
+	sweet_fb_set_number(color, "ID", SWEET_FB_COLOR_ID);
+	sweet_fb_set_number(color, "PixelEncoding", 0);
+	sweet_fb_set_number(color, "Depth", 8);
+	sweet_fb_set_number(color, "Colorimetry", 1);
+	sweet_fb_set_number(color, "EOTF", 1);
+	sweet_fb_set_number(color, "DynamicRange", 0);
+	sweet_fb_set_number(color, "Score", 1);
+	color->setObject("IsVirtual", kOSBooleanFalse);
+	colors->setObject(color);
+
+	sweet_fb_set_number(horizontal, "Active", width);
+	sweet_fb_set_number(horizontal, "Total", width);
+	sweet_fb_set_number(horizontal, "SyncRate", rate);
+	sweet_fb_set_number(horizontal, "PreciseSyncRate", rate);
+	sweet_fb_set_number(vertical, "Active", height);
+	sweet_fb_set_number(vertical, "Total", height);
+	sweet_fb_set_number(vertical, "SyncRate", rate);
+	sweet_fb_set_number(vertical, "PreciseSyncRate", rate);
+	sweet_fb_set_number(timing, "ID", SWEET_FB_TIMING_ID);
+	sweet_fb_set_number(timing, "Score", 1);
+	timing->setObject("IsVirtual", kOSBooleanFalse);
+	timing->setObject("IsOverscanned", kOSBooleanFalse);
+	timing->setObject("HorizontalAttributes", horizontal);
+	timing->setObject("VerticalAttributes", vertical);
+	timing->setObject("ColorModes", colors);
+	timings->setObject(timing);
+
+	fb->setProperty("TimingElements", timings);
+	fb->setProperty("ColorElements", colors);
+done:
+	OSSafeReleaseNULL(timings);
+	OSSafeReleaseNULL(colors);
+	OSSafeReleaseNULL(timing);
+	OSSafeReleaseNULL(horizontal);
+	OSSafeReleaseNULL(vertical);
+	OSSafeReleaseNULL(color);
+}
+
 class IOMobileFramebufferUserClient;
 
